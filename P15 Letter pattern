#include <iostream>
#include <string>
using namespace std;

int ReadPositiveNumber(string message)
{
	int N;
	cout << message << endl;
	cin >> N;
	return N;
}

void PrintLetterPattern(int N)
{
	cout << endl;
	for (int i = 65 ; i <= 65 + N - 1; i++)
	{
		for (int j = 1; j <= i -65 +1; j++)
		{
			cout << char(i);
		}
		cout << endl;
	}
}

int main()
{
	PrintLetterPattern(ReadPositiveNumber("Please enter a positive number:"));
	system("pause>0");
	return 0;
}
